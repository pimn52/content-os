{
  "$defs": {
    "AnalysisClipResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "clip_id": {
          "format": "uuid",
          "title": "Clip Id",
          "type": "string"
        },
        "start_ms": {
          "description": "Milliseconds from the source start.",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "transcript": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript"
        },
        "available_subtitles": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Available Subtitles",
          "type": "array"
        },
        "visual_description": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Description"
        },
        "people": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "People",
          "type": "array"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Objects",
          "type": "array"
        },
        "action": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/AnalysisKeyframe"
          },
          "maxItems": 100,
          "title": "Keyframes",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "start_ms",
        "end_ms"
      ],
      "title": "AnalysisClipResult",
      "type": "object"
    },
    "AnalysisKeyframe": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp_ms": {
          "description": "Milliseconds from the source start.",
          "minimum": 0,
          "title": "Timestamp Ms",
          "type": "integer"
        },
        "reference": {
          "description": "Stable local analysis reference; not a secret URL.",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "timestamp_ms",
        "reference"
      ],
      "title": "AnalysisKeyframe",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "input_hash": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^[A-Fa-f0-9]+$",
      "title": "Input Hash",
      "type": "string"
    },
    "mode": {
      "enum": [
        "assisted_test",
        "runtime"
      ],
      "title": "Mode",
      "type": "string"
    },
    "source": {
      "description": "Origin of the analysis result, never credentials.",
      "maxLength": 200,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "model": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "tool": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Tool",
      "type": "string"
    },
    "analyzed_at": {
      "format": "date-time",
      "title": "Analyzed At",
      "type": "string"
    },
    "ip_profile_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ip Profile Id"
    },
    "ip_profile_version": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ip Profile Version"
    },
    "profile_snapshot": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Profile Snapshot",
      "type": "object"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/AnalysisClipResult"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "input_hash",
    "mode",
    "source",
    "model",
    "tool",
    "analyzed_at",
    "results"
  ],
  "title": "AnalysisResultBundle",
  "type": "object"
}
