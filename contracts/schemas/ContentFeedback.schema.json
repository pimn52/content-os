{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "output_version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Output Version",
      "type": "string"
    },
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "changed_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Changed Fields",
      "type": "array"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    },
    "notes": {
      "anyOf": [
        {
          "maxLength": 10000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "output_version",
    "accepted",
    "created_at"
  ],
  "title": "ContentFeedback",
  "type": "object"
}
