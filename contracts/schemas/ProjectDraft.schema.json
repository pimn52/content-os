{
  "$defs": {
    "CandidateAsset": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_plan_id": {
          "format": "uuid",
          "title": "Scene Plan Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Id"
        },
        "match_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "why": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Why",
          "type": "array"
        },
        "reuse_count": {
          "default": 0,
          "minimum": 0,
          "title": "Reuse Count",
          "type": "integer"
        },
        "recommended": {
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        },
        "requires_capture": {
          "default": false,
          "title": "Requires Capture",
          "type": "boolean"
        },
        "estimated_cost": {
          "$ref": "#/$defs/UsageCost"
        }
      },
      "required": [
        "scene_plan_id",
        "source_kind",
        "match_score",
        "why",
        "estimated_cost"
      ],
      "title": "CandidateAsset",
      "type": "object"
    },
    "CostCategory": {
      "enum": [
        "user_asset",
        "historical_asset",
        "capture",
        "stock",
        "ai_image",
        "ai_video",
        "typography",
        "screenshot",
        "chart",
        "talking",
        "voice",
        "asr",
        "llm",
        "render"
      ],
      "title": "CostCategory",
      "type": "string"
    },
    "DraftRoute": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_plan_id": {
          "format": "uuid",
          "title": "Scene Plan Id",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateAsset"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "scene_plan_id",
        "candidates"
      ],
      "title": "DraftRoute",
      "type": "object"
    },
    "ProjectFormat": {
      "enum": [
        "vertical",
        "horizontal",
        "square"
      ],
      "title": "ProjectFormat",
      "type": "string"
    },
    "RationalFps": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "numerator": {
          "exclusiveMinimum": 0,
          "maximum": 240000,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalFps",
      "type": "object"
    },
    "ScenePlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "order": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "purpose": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "voice_text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Voice Text",
          "type": "string"
        },
        "duration_target_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Target Ms",
          "type": "integer"
        },
        "visual_intent": {
          "$ref": "#/$defs/VisualIntent"
        },
        "preferred_sources": {
          "items": {
            "$ref": "#/$defs/SourceKind"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Preferred Sources",
          "type": "array"
        },
        "fallback_sources": {
          "items": {
            "$ref": "#/$defs/SourceKind"
          },
          "maxItems": 10,
          "title": "Fallback Sources",
          "type": "array"
        },
        "caption_emphasis": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Caption Emphasis",
          "type": "array"
        },
        "evidence_refs": {
          "description": "Traceable IP/material evidence identifiers.",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "scene_id",
        "order",
        "purpose",
        "voice_text",
        "duration_target_ms",
        "visual_intent",
        "preferred_sources"
      ],
      "title": "ScenePlan",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "user_asset",
        "historical_asset",
        "capture",
        "stock",
        "ai_image",
        "ai_video",
        "typography",
        "screenshot",
        "chart",
        "talking_profile"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "UsageCost": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CostCategory"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,13}0*$)\\d{0,8}\\.\\d{0,4}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "category"
      ],
      "title": "UsageCost",
      "type": "object"
    },
    "VideoCaption": {
      "additionalProperties": false,
      "description": "A caption interval relative to the containing video scene.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "description": "Milliseconds from the source start.",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "text"
      ],
      "title": "VideoCaption",
      "type": "object"
    },
    "VideoScene": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "visual": {
          "$ref": "#/$defs/VideoVisual"
        },
        "narration_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration Asset Id"
        },
        "narration_start_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration Start Ms"
        },
        "narration_end_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration End Ms"
        },
        "caption": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "captions": {
          "items": {
            "$ref": "#/$defs/VideoCaption"
          },
          "maxItems": 1000,
          "title": "Captions",
          "type": "array"
        },
        "transition": {
          "default": "cut",
          "maxLength": 100,
          "title": "Transition",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "start_frame",
        "duration_frames",
        "visual"
      ],
      "title": "VideoScene",
      "type": "object"
    },
    "VideoSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/ProjectFormat"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "$ref": "#/$defs/RationalFps"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/VideoScene"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "voice_profile_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Profile Id"
        },
        "estimated_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageCost"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "project_id",
        "format",
        "width",
        "height",
        "fps",
        "scenes"
      ],
      "title": "VideoSpec",
      "type": "object"
    },
    "VideoVisual": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "authorization_reference": {
          "description": "Reference to the source rights record; never credentials.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Authorization Reference",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Id"
        },
        "clip_start_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Start Ms"
        },
        "clip_end_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip End Ms"
        },
        "source_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Duration Ms"
        }
      },
      "required": [
        "source_kind",
        "authorization_reference"
      ],
      "title": "VideoVisual",
      "type": "object"
    },
    "VisualIntent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "action": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "framing": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framing"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "title": "VisualIntent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "version": {
      "default": 0,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "script_revision": {
      "default": 0,
      "minimum": 0,
      "title": "Script Revision",
      "type": "integer"
    },
    "script": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Script"
    },
    "topic": {
      "anyOf": [
        {
          "maxLength": 5000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Topic"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/ScenePlan"
      },
      "maxItems": 1000,
      "title": "Scenes",
      "type": "array"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/DraftRoute"
      },
      "maxItems": 1000,
      "title": "Routes",
      "type": "array"
    },
    "confirmed": {
      "items": {
        "$ref": "#/$defs/CandidateAsset"
      },
      "maxItems": 1000,
      "title": "Confirmed",
      "type": "array"
    },
    "video_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/VideoSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ip_profile_version": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ip Profile Version"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Evidence Refs",
      "type": "array"
    },
    "input_fingerprint": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 16,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Fingerprint"
    },
    "invalidation_reasons": {
      "items": {
        "enum": [
          "script_changed",
          "topic_changed",
          "scene_copy_changed",
          "ip_profile_changed"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "title": "Invalidation Reasons",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "updated_at"
  ],
  "title": "ProjectDraft",
  "type": "object"
}
