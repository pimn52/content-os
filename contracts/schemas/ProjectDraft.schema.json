{
  "$defs": {
    "CandidateAsset": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_plan_id": {
          "format": "uuid",
          "title": "Scene Plan Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Id"
        },
        "playback_start_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playback Start Ms"
        },
        "playback_end_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playback End Ms"
        },
        "match_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "why": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Why",
          "type": "array"
        },
        "reuse_count": {
          "default": 0,
          "minimum": 0,
          "title": "Reuse Count",
          "type": "integer"
        },
        "recommended": {
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        },
        "requires_capture": {
          "default": false,
          "title": "Requires Capture",
          "type": "boolean"
        },
        "estimated_cost": {
          "$ref": "#/$defs/UsageCost"
        }
      },
      "required": [
        "scene_plan_id",
        "source_kind",
        "match_score",
        "why",
        "estimated_cost"
      ],
      "title": "CandidateAsset",
      "type": "object"
    },
    "CostCategory": {
      "enum": [
        "user_asset",
        "historical_asset",
        "capture",
        "stock",
        "ai_image",
        "ai_video",
        "typography",
        "screenshot",
        "chart",
        "talking",
        "voice",
        "asr",
        "llm",
        "render"
      ],
      "title": "CostCategory",
      "type": "string"
    },
    "DraftRoute": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_plan_id": {
          "format": "uuid",
          "title": "Scene Plan Id",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateAsset"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "scene_plan_id",
        "candidates"
      ],
      "title": "DraftRoute",
      "type": "object"
    },
    "EditPlan": {
      "additionalProperties": false,
      "description": "Visual-direction bridge from ScenePlan/routed assets to VideoSpec.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/EditPlanScene"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "style_tokens": {
          "$ref": "#/$defs/VisualStyleTokens"
        }
      },
      "required": [
        "project_id",
        "scenes"
      ],
      "title": "EditPlan",
      "type": "object"
    },
    "EditPlanFallback": {
      "additionalProperties": false,
      "description": "An explicit local graphic fallback if the selected visual cannot be used.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "const": "typography",
          "default": "typography",
          "title": "Source Kind",
          "type": "string"
        },
        "graphic_treatment": {
          "$ref": "#/$defs/GraphicTreatment"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "graphic_treatment",
        "text"
      ],
      "title": "EditPlanFallback",
      "type": "object"
    },
    "EditPlanScene": {
      "additionalProperties": false,
      "description": "One provider-neutral presentation decision for one routed ScenePlan.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_plan_id": {
          "format": "uuid",
          "title": "Scene Plan Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "visual_role": {
          "$ref": "#/$defs/EditVisualRole"
        },
        "selected_source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "selected_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Asset Id"
        },
        "selected_clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Clip Id"
        },
        "framing_policy": {
          "$ref": "#/$defs/TalkingFramingPolicy",
          "default": "face_safe_contain"
        },
        "portrait_presentation": {
          "$ref": "#/$defs/PortraitPresentation",
          "default": "full_canvas"
        },
        "crop_safety_evidence_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Safety Evidence Reference"
        },
        "crop_safety_start_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Safety Start Ms"
        },
        "crop_safety_end_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Safety End Ms"
        },
        "subtitle_treatment": {
          "$ref": "#/$defs/SubtitleTreatment",
          "default": "timed_captions"
        },
        "burned_in_subtitles": {
          "default": "unknown",
          "enum": [
            "unknown",
            "present",
            "absent"
          ],
          "title": "Burned In Subtitles",
          "type": "string"
        },
        "source_bottom_crop_ratio": {
          "default": 0,
          "maximum": 0.4,
          "minimum": 0,
          "title": "Source Bottom Crop Ratio",
          "type": "number"
        },
        "source_subtitle_evidence_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Subtitle Evidence Reference"
        },
        "graphic_treatment": {
          "$ref": "#/$defs/GraphicTreatment",
          "default": "none"
        },
        "graphic_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graphic Text"
        },
        "transition_intent": {
          "const": "cut",
          "default": "cut",
          "title": "Transition Intent",
          "type": "string"
        },
        "fallback": {
          "$ref": "#/$defs/EditPlanFallback"
        }
      },
      "required": [
        "scene_plan_id",
        "scene_id",
        "visual_role",
        "selected_source_kind",
        "fallback"
      ],
      "title": "EditPlanScene",
      "type": "object"
    },
    "EditVisualRole": {
      "description": "Editorial presentation role, independent of the renderer or provider.",
      "enum": [
        "talking",
        "footage",
        "graphic"
      ],
      "title": "EditVisualRole",
      "type": "string"
    },
    "GraphicCardPlan": {
      "additionalProperties": false,
      "description": "Explicit executable text card, or a named unsupported visual need.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text_card",
            "diagram",
            "unsupported",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "treatment": {
          "anyOf": [
            {
              "enum": [
                "headline",
                "key_point",
                "contrast",
                "diagram_flow",
                "diagram_loss",
                "diagram_factors"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Treatment"
        },
        "points": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Points",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "kind"
      ],
      "title": "GraphicCardPlan",
      "type": "object"
    },
    "GraphicTreatment": {
      "enum": [
        "none",
        "headline",
        "key_point",
        "contrast",
        "diagram_flow",
        "diagram_loss",
        "diagram_factors"
      ],
      "title": "GraphicTreatment",
      "type": "string"
    },
    "MasterNarration": {
      "additionalProperties": false,
      "description": "One authorized, timestamped narration track driving a whole VideoSpec.\n\nThe audio remains a single continuous local asset.  Video scenes reference\nintervals on this track for provenance and caption timing; they do not\neach replay the recording from its beginning.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "audio_asset_id": {
          "format": "uuid",
          "title": "Audio Asset Id",
          "type": "string"
        },
        "start_ms": {
          "default": 0,
          "description": "Milliseconds from the source start.",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "transcript_source": {
          "description": "Traceable provider alignment or imported SRT/VTT reference.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Transcript Source",
          "type": "string"
        },
        "transcript_segments": {
          "items": {
            "$ref": "#/$defs/TranscriptSegment"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Transcript Segments",
          "type": "array"
        }
      },
      "required": [
        "audio_asset_id",
        "end_ms",
        "transcript_source",
        "transcript_segments"
      ],
      "title": "MasterNarration",
      "type": "object"
    },
    "MaterialRequest": {
      "additionalProperties": false,
      "description": "\u5c1a\u672a\u53d6\u5f97\u7684\u753b\u9762\u9700\u6c42\uff0c\u4e0d\u80fd\u4f5c\u4e3a\u5df2\u6709\u7d20\u6750\u8fdb\u5165\u88c5\u914d\u3002",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "stock",
            "ai_broll"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "query": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "query",
        "reason"
      ],
      "title": "MaterialRequest",
      "type": "object"
    },
    "NarrationEmphasis": {
      "description": "Relative prominence for a spoken range of copy.",
      "enum": [
        "light",
        "clear",
        "strong"
      ],
      "title": "NarrationEmphasis",
      "type": "string"
    },
    "NarrationPace": {
      "description": "Editorial pace direction, deliberately not a provider speed value.",
      "enum": [
        "measured",
        "conversational",
        "driven"
      ],
      "title": "NarrationPace",
      "type": "string"
    },
    "NarrationPause": {
      "description": "Semantic pause length, never a provider-specific millisecond control.",
      "enum": [
        "brief",
        "beat",
        "long"
      ],
      "title": "NarrationPause",
      "type": "string"
    },
    "NarrationPerformanceCue": {
      "additionalProperties": false,
      "description": "One semantic delivery instruction anchored to character positions.\n\nCharacter positions are Python/Unicode character offsets in the exact\ncurrent copy. They avoid forcing English-word tokenization onto Chinese\nscripts while keeping a deterministic, auditable anchor for every cue.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NarrationPerformanceCueKind"
        },
        "start_char": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "maximum": 100000,
          "minimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "emphasis": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrationEmphasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pace": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrationPace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pause": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrationPause"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rhythm": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrationRhythm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "kind",
        "start_char",
        "end_char"
      ],
      "title": "NarrationPerformanceCue",
      "type": "object"
    },
    "NarrationPerformanceCueKind": {
      "enum": [
        "emphasis",
        "pace",
        "pause",
        "rhythm"
      ],
      "title": "NarrationPerformanceCueKind",
      "type": "string"
    },
    "NarrationPerformancePlan": {
      "additionalProperties": false,
      "description": "Editable, provider-neutral delivery direction for exact narration copy.\n\nThis is narrative intent, not SSML or an execution configuration. A Voice\nadapter may later report that it applied an immutable copy of this plan,\nbut the plan alone never claims an acoustic result.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "copy_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Copy Fingerprint",
          "type": "string"
        },
        "delivery_goal": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Delivery Goal",
          "type": "string"
        },
        "overall_pace": {
          "$ref": "#/$defs/NarrationPace",
          "default": "conversational"
        },
        "cues": {
          "items": {
            "$ref": "#/$defs/NarrationPerformanceCue"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Cues",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/NarrationPerformancePlanSource",
          "default": "user"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "copy_fingerprint",
        "delivery_goal",
        "cues"
      ],
      "title": "NarrationPerformancePlan",
      "type": "object"
    },
    "NarrationPerformancePlanSource": {
      "description": "Who supplied the editable delivery direction.",
      "enum": [
        "user",
        "assisted",
        "imported"
      ],
      "title": "NarrationPerformancePlanSource",
      "type": "string"
    },
    "NarrationRhythm": {
      "description": "The rhetorical job a range plays in the delivery.",
      "enum": [
        "setup",
        "build",
        "turn",
        "land"
      ],
      "title": "NarrationRhythm",
      "type": "string"
    },
    "PortraitPresentation": {
      "description": "Where an authorized source sits inside the vertical output canvas.",
      "enum": [
        "full_canvas",
        "portrait_panel",
        "stacked_comparison"
      ],
      "title": "PortraitPresentation",
      "type": "string"
    },
    "ProjectFormat": {
      "enum": [
        "vertical",
        "horizontal",
        "square"
      ],
      "title": "ProjectFormat",
      "type": "string"
    },
    "RationalFps": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "numerator": {
          "exclusiveMinimum": 0,
          "maximum": 240000,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalFps",
      "type": "object"
    },
    "ScenePlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "order": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "purpose": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "voice_text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Voice Text",
          "type": "string"
        },
        "duration_target_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Target Ms",
          "type": "integer"
        },
        "visual_intent": {
          "$ref": "#/$defs/VisualIntent"
        },
        "supporting_visual_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u53ef\u66ff\u4ee3\u672c\u4eba\u53ef\u89c1\u8bb2\u8ff0\u7684\u5207\u9898\u5b9e\u62cd\u610f\u56fe\uff1b\u4e0d\u53ef\u66ff\u4ee3\u4e0d\u53ef\u7f3a\u7684\u672c\u4eba\u8868\u6f14\u6216\u4e8b\u5b9e\u8bc1\u636e\u3002"
        },
        "preferred_clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Clip Id"
        },
        "graphic_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphicCardPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preferred_sources": {
          "items": {
            "$ref": "#/$defs/SourceKind"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Preferred Sources",
          "type": "array"
        },
        "fallback_sources": {
          "items": {
            "$ref": "#/$defs/SourceKind"
          },
          "maxItems": 10,
          "title": "Fallback Sources",
          "type": "array"
        },
        "caption_emphasis": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Caption Emphasis",
          "type": "array"
        },
        "evidence_refs": {
          "description": "Traceable IP/material evidence identifiers.",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "visual_requirement": {
          "default": "unknown",
