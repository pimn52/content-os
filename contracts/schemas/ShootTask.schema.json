      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "scene_plan_id": {
      "format": "uuid",
      "title": "Scene Plan Id",
      "type": "string"
    },
    "scene_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Scene Id",
      "type": "string"
    },
    "what_to_shoot": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "What To Shoot",
      "type": "string"
    },
    "framing": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Framing",
      "type": "string"
