{
  "$defs": {
    "CostCategory": {
      "enum": [
        "user_asset",
        "historical_asset",
        "capture",
        "stock",
        "ai_image",
        "ai_video",
        "typography",
        "screenshot",
        "chart",
        "talking",
        "voice",
        "asr",
        "llm",
        "render"
      ],
      "title": "CostCategory",
      "type": "string"
    },
    "EditPlan": {
      "additionalProperties": false,
      "description": "Visual-direction bridge from ScenePlan/routed assets to VideoSpec.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/EditPlanScene"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "style_tokens": {
          "$ref": "#/$defs/VisualStyleTokens"
        }
      },
      "required": [
        "project_id",
        "scenes"
      ],
      "title": "EditPlan",
      "type": "object"
    },
    "EditPlanFallback": {
      "additionalProperties": false,
      "description": "An explicit local graphic fallback if the selected visual cannot be used.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "const": "typography",
          "default": "typography",
          "title": "Source Kind",
          "type": "string"
        },
        "graphic_treatment": {
          "$ref": "#/$defs/GraphicTreatment"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "graphic_treatment",
        "text"
      ],
      "title": "EditPlanFallback",
      "type": "object"
    },
    "EditPlanScene": {
      "additionalProperties": false,
      "description": "One provider-neutral presentation decision for one routed ScenePlan.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_plan_id": {
          "format": "uuid",
          "title": "Scene Plan Id",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "visual_role": {
          "$ref": "#/$defs/EditVisualRole"
        },
        "selected_source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "selected_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Asset Id"
        },
        "selected_clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Clip Id"
        },
        "framing_policy": {
          "$ref": "#/$defs/TalkingFramingPolicy",
          "default": "face_safe_contain"
        },
        "portrait_presentation": {
          "$ref": "#/$defs/PortraitPresentation",
          "default": "full_canvas"
        },
        "crop_safety_evidence_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Safety Evidence Reference"
        },
        "crop_safety_start_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Safety Start Ms"
        },
        "crop_safety_end_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Safety End Ms"
        },
        "subtitle_treatment": {
          "$ref": "#/$defs/SubtitleTreatment",
          "default": "timed_captions"
        },
        "burned_in_subtitles": {
          "default": "unknown",
          "enum": [
            "unknown",
            "present",
            "absent"
          ],
          "title": "Burned In Subtitles",
          "type": "string"
        },
        "source_bottom_crop_ratio": {
          "default": 0,
          "maximum": 0.4,
          "minimum": 0,
          "title": "Source Bottom Crop Ratio",
          "type": "number"
        },
        "source_subtitle_evidence_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Subtitle Evidence Reference"
        },
        "graphic_treatment": {
          "$ref": "#/$defs/GraphicTreatment",
          "default": "none"
        },
        "graphic_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graphic Text"
        },
        "transition_intent": {
          "const": "cut",
          "default": "cut",
          "title": "Transition Intent",
          "type": "string"
        },
        "fallback": {
          "$ref": "#/$defs/EditPlanFallback"
        }
      },
      "required": [
        "scene_plan_id",
        "scene_id",
        "visual_role",
        "selected_source_kind",
        "fallback"
      ],
      "title": "EditPlanScene",
      "type": "object"
    },
    "EditVisualRole": {
      "description": "Editorial presentation role, independent of the renderer or provider.",
      "enum": [
        "talking",
        "footage",
        "graphic"
      ],
      "title": "EditVisualRole",
      "type": "string"
    },
    "GraphicTreatment": {
      "enum": [
        "none",
        "headline",
        "key_point",
        "contrast",
        "diagram_flow",
        "diagram_loss",
        "diagram_factors"
      ],
      "title": "GraphicTreatment",
      "type": "string"
    },
    "MasterNarration": {
      "additionalProperties": false,
      "description": "One authorized, timestamped narration track driving a whole VideoSpec.\n\nThe audio remains a single continuous local asset.  Video scenes reference\nintervals on this track for provenance and caption timing; they do not\neach replay the recording from its beginning.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "audio_asset_id": {
          "format": "uuid",
          "title": "Audio Asset Id",
          "type": "string"
        },
        "start_ms": {
          "default": 0,
          "description": "Milliseconds from the source start.",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "transcript_source": {
          "description": "Traceable provider alignment or imported SRT/VTT reference.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Transcript Source",
          "type": "string"
        },
        "transcript_segments": {
          "items": {
            "$ref": "#/$defs/TranscriptSegment"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Transcript Segments",
          "type": "array"
        }
      },
      "required": [
        "audio_asset_id",
        "end_ms",
        "transcript_source",
        "transcript_segments"
      ],
      "title": "MasterNarration",
      "type": "object"
    },
    "PortraitPresentation": {
      "description": "Where an authorized source sits inside the vertical output canvas.",
      "enum": [
        "full_canvas",
        "portrait_panel",
        "stacked_comparison"
      ],
      "title": "PortraitPresentation",
      "type": "string"
    },
    "ProjectFormat": {
      "enum": [
        "vertical",
        "horizontal",
        "square"
      ],
      "title": "ProjectFormat",
      "type": "string"
    },
    "RationalFps": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "numerator": {
          "exclusiveMinimum": 0,
          "maximum": 240000,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalFps",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "user_asset",
        "historical_asset",
        "capture",
        "stock",
        "ai_image",
        "ai_video",
        "ai_broll",
        "typography",
        "screenshot",
        "chart",
        "talking_profile"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SubtitleTreatment": {
      "enum": [
        "timed_captions",
        "none"
      ],
      "title": "SubtitleTreatment",
      "type": "string"
    },
    "TalkingFramingPolicy": {
      "description": "Bounded R1 framing choices for creator Talking footage.",
      "enum": [
        "face_safe_contain",
        "verified_static_crop"
      ],
      "title": "TalkingFramingPolicy",
      "type": "string"
    },
    "TranscriptSegment": {
      "additionalProperties": false,
      "description": "A persisted, source-relative spoken interval returned by ASR.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "description": "Milliseconds from the source start.",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "text"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    },
    "UsageCost": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/CostCategory"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,13}0*$)\\d{0,8}\\.\\d{0,4}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "category"
      ],
      "title": "UsageCost",
      "type": "object"
    },
    "VerticalReframeMode": {
      "description": "An explicit, reviewable treatment of non-vertical source media.",
      "enum": [
        "contain",
        "center_crop",
        "bottom_crop_contain"
      ],
      "title": "VerticalReframeMode",
      "type": "string"
    },
    "VideoCaption": {
      "additionalProperties": false,
      "description": "A caption interval relative to the containing video scene.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "start_ms": {
          "description": "Milliseconds from the source start.",
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "text"
      ],
      "title": "VideoCaption",
      "type": "object"
    },
    "VideoScene": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "visual": {
          "$ref": "#/$defs/VideoVisual"
        },
        "narration_asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration Asset Id"
        },
        "narration_start_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration Start Ms"
        },
        "narration_end_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration End Ms"
        },
        "caption": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "captions": {
          "items": {
            "$ref": "#/$defs/VideoCaption"
          },
          "maxItems": 1000,
          "title": "Captions",
          "type": "array"
        },
        "transition": {
          "default": "cut",
          "maxLength": 100,
          "title": "Transition",
          "type": "string"
        },
        "visual_role": {
          "$ref": "#/$defs/EditVisualRole",
          "default": "footage"
        },
        "framing_policy": {
          "$ref": "#/$defs/TalkingFramingPolicy",
          "default": "face_safe_contain"
        },
        "portrait_presentation": {
          "$ref": "#/$defs/PortraitPresentation",
          "default": "full_canvas"
        },
        "subtitle_treatment": {
          "$ref": "#/$defs/SubtitleTreatment",
          "default": "timed_captions"
        },
        "graphic_treatment": {
          "$ref": "#/$defs/GraphicTreatment",
          "default": "none"
        },
        "graphic_text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graphic Text"
        },
        "style_tokens": {
          "$ref": "#/$defs/VisualStyleTokens"
        }
      },
      "required": [
        "scene_id",
        "start_frame",
        "duration_frames",
        "visual"
      ],
      "title": "VideoScene",
      "type": "object"
    },
    "VideoVisual": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "authorization_reference": {
          "description": "Reference to the source rights record; never credentials.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Authorization Reference",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "clip_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Id"
        },
        "clip_start_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Start Ms"
        },
        "clip_end_ms": {
          "anyOf": [
            {
              "description": "Milliseconds from the source start.",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip End Ms"
        },
        "source_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Duration Ms"
        },
        "vertical_reframe_mode": {
          "$ref": "#/$defs/VerticalReframeMode",
          "default": "contain"
        },
        "vertical_reframe_evidence_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertical Reframe Evidence Reference"
        },
        "source_bottom_crop_ratio": {
          "default": 0,
          "maximum": 0.4,
          "minimum": 0,
          "title": "Source Bottom Crop Ratio",
          "type": "number"
        }
      },
      "required": [
        "source_kind",
        "authorization_reference"
      ],
      "title": "VideoVisual",
      "type": "object"
    },
    "VisualStyleTokens": {
      "additionalProperties": false,
      "description": "Reusable visual tokens consumed by the renderer, never provider settings.",
      "properties": {
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "name": {
          "default": "content-os-dark",
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "background_color": {
          "default": "#172033",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background Color",
          "type": "string"
        },
        "foreground_color": {
          "default": "#f8fbff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Foreground Color",
          "type": "string"
        },
        "accent_color": {
          "default": "#65d3b4",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent Color",
          "type": "string"
        },
        "font_family": {
          "default": "Inter, ui-sans-serif, system-ui",
          "maxLength": 500,
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        }
      },
      "title": "VisualStyleTokens",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/ProjectFormat"
    },
    "width": {
      "exclusiveMinimum": 0,
      "maximum": 16384,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "exclusiveMinimum": 0,
      "maximum": 16384,
      "title": "Height",
      "type": "integer"
    },
    "fps": {
      "$ref": "#/$defs/RationalFps"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/VideoScene"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "master_narration": {
      "anyOf": [
        {
          "$ref": "#/$defs/MasterNarration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "voice_profile_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voice Profile Id"
    },
    "estimated_cost": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageCost"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "edit_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "project_id",
    "format",
    "width",
    "height",
    "fps",
    "scenes"
  ],
  "title": "VideoSpec",
  "type": "object"
}
